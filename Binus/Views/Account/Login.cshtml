@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Flu Vaccine Registration - Login</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Please sign in with your Binusian ID to continue.</p>

                    <form method="post" asp-controller="Account" asp-action="Login">
                        <div class="mb-3">
                            <label for="binusianId" class="form-label">Binusian ID</label>
                            <input type="text" id="binusianId" name="binusianId" class="form-control" placeholder="Enter your Binusian ID" required />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Password" required />
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>
                    </form>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-3">Invalid login attempt.</div>
                    }
                </div>
                <div class="card-footer text-muted small">
                    Contact admin if you have trouble logging in.
                </div>
            </div>
        </div>
    </div>
</div>
